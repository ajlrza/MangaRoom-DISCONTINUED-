{
  "compilerOptions": {
    "jsx": "react",
    "baseUrl": ".",
    "target": "es2016",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@components/*": ["src/components/*"],
      "@utils/*": ["src/lib/utils/*"]
    },
  }
}
